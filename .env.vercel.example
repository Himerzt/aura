# =============================================================
# AURA — Environment Variables for Vercel Dashboard
# =============================================================
# Add these in: Vercel Dashboard → Project → Settings → Environment Variables
#
# FRONTEND (Vercel):
# ──────────────────────────────────────────────────────────────

# URL của backend (Railway)
# Sau khi deploy backend lên Railway, lấy URL từ Railway Dashboard
# Ví dụ: https://aura-backend.up.railway.app
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app

# BACKEND_ORIGIN: proxy route dùng để forward /api/* tới backend
# Dùng cùng URL với NEXT_PUBLIC_API_URL (backend phải set CORS đúng)
BACKEND_ORIGIN=https://your-backend.up.railway.app

# ──────────────────────────────────────────────────────────────
# NOTE: Không cần backend env vars trên Vercel
# Backend env vars (GEMINI_API_KEY, ALLOWED_ORIGINS, DATABASE_PROVIDER...)
# được set trên Railway Dashboard của backend service.
# =============================================================

# =============================================================
# AURA — Environment Variables for Railway Backend
# =============================================================
# Add these in: Railway Dashboard → Backend Project → Variables
#
# BACKEND (Railway):
# ──────────────────────────────────────────────────────────────

# BẮT BUỘC — Gemini API
GEMINI_API_KEY=AIza...

# Recommended model fallback for temporary 503/high-demand errors
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# BẮT BUỘC — CORS origins (thay bằng Vercel frontend URL)
ALLOWED_ORIGINS=https://your-project.vercel.app

# TÙY CHỌN — Database (nếu muốn dùng Supabase thay vì JSON files)
# DATABASE_PROVIDER=supabase
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# =============================================================
