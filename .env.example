# =============================================================
# AURA — Environment Variables
# Sao chép file này thành .env rồi điền giá trị thực
# cp .env.example .env
# =============================================================

# ------------------------------------------------------------
# REQUIRED — Backend (FastAPI)
# ------------------------------------------------------------

# Gemini API key — lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model config
# Primary keeps the current demo behavior. Fallback uses a stable lower-demand
# model when the preview model returns temporary 503/high-demand errors.
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# CORS: origin nào được phép gọi API
# Local: http://localhost:3000
# Production (Vercel + Railway): https://your-frontend.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------
# REQUIRED — Frontend (Next.js)
# ------------------------------------------------------------

# Server-side proxy target for /api/*
# Local dev: http://localhost:8000
# Production (Vercel + Railway): https://your-backend.up.railway.app
BACKEND_ORIGIN=http://localhost:8000

# Optional browser-side override. Leave empty in Vercel so calls go through the
# Next.js proxy above; set only when intentionally calling backend directly.
NEXT_PUBLIC_API_URL=

# ------------------------------------------------------------
# OPTIONAL — Database Provider (Supabase)
# ------------------------------------------------------------
# Uncomment dòng dưới và cấu hình Supabase nếu muốn dùng database thay vì JSON files.
# Chi tiết: docs/VERCEL_MIGRATION.md

# DATABASE_PROVIDER=supabase
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ------------------------------------------------------------
# OPTIONAL — Railway deployment
# ------------------------------------------------------------
# PORT=8000  # Railway tự set PORT, không cần khai báo
