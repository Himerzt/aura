# =============================================================
# AURA — Environment Variables
# Sao chép file này thành .env rồi điền giá trị thực
# cp .env.example .env
# =============================================================

# ------------------------------------------------------------
# REQUIRED — Backend (FastAPI)
# ------------------------------------------------------------

# Gemini API key — lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# CORS: origin nào được phép gọi API
# Local: http://localhost:3000
# Production (Railway): https://your-frontend.up.railway.app
ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------
# REQUIRED — Frontend (Next.js)
# ------------------------------------------------------------

# URL của backend API — frontend dùng biến này để gọi API
# Local (qua Nginx): http://localhost:8000
# Production (Railway): https://your-backend.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------
# OPTIONAL — Chỉ cần khi deploy lên Railway
# ------------------------------------------------------------

# Port backend lắng nghe (Railway tự set PORT, không cần đổi)
# PORT=8000
